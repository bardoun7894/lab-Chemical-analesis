# GCP QC Pipes Traceability - Environment Variables

# Gemini AI API Key (required for AI features)
GEMINI_API_KEY=your-api-key-here

# Default admin password (used only on first run when creating admin user)
# If not set, a random password will be generated and printed to console
ADMIN_DEFAULT_PASSWORD=change-me-in-production

# REST API key (for /api/v1/ endpoints - Power BI, external integrations)
API_KEY=generate-a-secure-random-key

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=production
